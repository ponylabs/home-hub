# 默认只监听本机。首次运行不需要任何密钥。
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=data/home-hub.sqlite
DEMO_MODE=true

# 可选：OpenAI-compatible Chat Completions，密钥仅在服务端使用。
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=

# 可选：接入 Home Assistant；首版不需要真实设备。
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=

# 监听非 loopback 地址时必填。网页与 MCP 均使用该令牌认证。
# HUB_API_TOKEN=
